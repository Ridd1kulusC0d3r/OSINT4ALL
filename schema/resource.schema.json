{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ridd1kulusC0d3r/OSINT4ALL/blob/main/schema/resource.schema.json",
  "title": "OSINT4ALL Resource Catalog",
  "type": "object",
  "required": [
    "catalog_version",
    "resources"
  ],
  "properties": {
    "catalog_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_policy": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "canonical_url",
          "jurisdictions",
          "disciplines",
          "domains",
          "use_cases",
          "source_type",
          "access",
          "languages",
          "status",
          "last_verified",
          "catalog_added"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "canonical_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "jurisdictions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(GLOBAL|[A-Z]{2}(-[A-Z0-9]{1,3})?)$"
            }
          },
          "disciplines": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "OSINT",
                "HUMINT",
                "SIGINT",
                "COMINT",
                "ELINT",
                "FISINT",
                "GEOINT",
                "IMINT",
                "MASINT",
                "TECHINT",
                "CYBINT",
                "CTI",
                "MEDINT",
                "FININT",
                "DOMEX",
                "WEBINT",
                "DNINT",
                "SOCMINT"
              ]
            }
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "use_cases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "source_type": {
            "enum": [
              "official",
              "academic",
              "nonprofit",
              "commercial",
              "community",
              "open-source"
            ]
          },
          "access": {
            "enum": [
              "free",
              "freemium",
              "paid",
              "account",
              "api-key",
              "local",
              "mixed"
            ]
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "verified",
              "needs-review",
              "changed",
              "broken-unsafe",
              "historical"
            ]
          },
          "last_verified": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "notes": {
            "type": "string"
          },
          "intelligence_levels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "strategic",
                "operational",
                "tactical"
              ]
            }
          },
          "cycle_stages": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "direction",
                "collection",
                "processing",
                "analysis",
                "dissemination",
                "feedback"
              ]
            }
          },
          "target_inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "aircraft-id",
                "asn",
                "audio",
                "bssid-ssid",
                "cidr",
                "coordinates",
                "crypto-address",
                "cve-id",
                "dataset",
                "document",
                "domain",
                "email",
                "event-data",
                "file",
                "file-hash",
                "image",
                "ip-address",
                "keyword",
                "location",
                "name",
                "no-fixed-input",
                "onion-service",
                "organization-name",
                "phone-number",
                "repository-url",
                "satellite-id",
                "text",
                "url",
                "username",
                "vessel-id",
                "video"
              ]
            }
          },
          "implementation_type": {
            "type": "string",
            "enum": [
              "agent",
              "agent-plus-mcp",
              "bookmarklet",
              "browser-extension",
              "cli",
              "dataset-tool",
              "desktop",
              "documentation",
              "framework",
              "library",
              "mcp-server",
              "meta-index",
              "platform",
              "plugin",
              "service",
              "skill",
              "skill-pack",
              "web-app"
            ]
          },
          "upstream_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]+$"
            }
          },
          "catalog_added": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "jurisdiction_inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}:[a-z0-9][a-z0-9-]*$"
            }
          },
          "output_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "registry-data",
                "registration-status",
                "company-officers",
                "economic-activity",
                "address",
                "case-record",
                "case-parties",
                "case-movement",
                "certificate",
                "criminal-record",
                "arrest-warrant",
                "social-benefit",
                "public-compensation",
                "public-contract",
                "procurement",
                "sanction",
                "vehicle-data",
                "fine",
                "financial-debt",
                "property-data",
                "rural-area",
                "environmental-license",
                "enforcement-notice",
                "telecom-operator",
                "cell-site",
                "radio-frequency",
                "broadcast-license",
                "dataset",
                "official-gazette",
                "json-api",
                "map-layer",
                "satellite-imagery",
                "live-video",
                "cv-profile",
                "academic-publication",
                "social-profile",
                "search-query",
                "statistics",
                "professional-link",
                "financing",
                "registry-office"
              ]
            }
          },
          "authority_scope": {
            "type": "string",
            "enum": [
              "federal",
              "state",
              "municipal",
              "judiciary",
              "public-prosecutor",
              "legislative",
              "public-defender",
              "nonprofit",
              "private",
              "academic",
              "international",
              "api",
              "dork",
              "unknown"
            ]
          }
        }
      }
    }
  }
}
